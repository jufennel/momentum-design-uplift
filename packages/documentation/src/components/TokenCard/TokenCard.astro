---
import './TokenCard.css';

type Props = {
  name: string;
  link: string;
  disabled?: boolean;
};

const { name, link, disabled } = Astro.props as Props;
const href = `${import.meta.env.BASE_URL}${link.replace(/^\//, '')}`;
---

<a id={name} class="card" href={href} aria-disabled={disabled}>
  {name.replace('-', ' ')}
</a>
